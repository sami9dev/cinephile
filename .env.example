# ==============================================================================
# CiNEPHiLE — Unified Environment Variables Template
#
# Covers all 9 Architectural Services:
# 1. Next.js
# 2. Rust / Axum Backend
# 3. MongoDB Atlas (Authoritative DB)
# 4. Upstash Redis (Cache & Rate Limits)
# 5. Cloudflare R2 (Media Storage)
# 6. Firebase Authentication
# 7. TMDB API (Metadata)
# 8. Telegram Bot API (Admin Automation)
# 9. Cloudflare Workers (Edge Runtime)
#
# DO NOT COMMIT REAL CREDENTIALS. Copy this file to `.env.local` for local
# development or configure variables in your staging deployment environments.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NEXT.JS FRONTEND & APPLICATION CORE
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PORT=3000
APP_ENV=staging
CINEFUEL_ENV=staging

# Optional: route high-throughput APIs to Rust backend when running
# NEXT_PUBLIC_API_BACKEND=http://127.0.0.1:8080

# ------------------------------------------------------------------------------
# 2. RUST / AXUM CONTROL PLANE & ADMIN AUTHENTICATION
# ------------------------------------------------------------------------------
ADMIN_SECRET_KEY=generate_a_secure_random_hex_key_for_hmac_sessions
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_EMAILS=admin@example.com

# ------------------------------------------------------------------------------
# 3. MONGODB ATLAS (AUTHORITATIVE METADATA DATABASE)
# ------------------------------------------------------------------------------
# Connection string to MongoDB Atlas. Use a dedicated staging database in dev/staging.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=cinefuel_staging

# ------------------------------------------------------------------------------
# 4. UPSTASH REDIS (CATALOG CACHE & EPHEMERAL RATE LIMITING)
# ------------------------------------------------------------------------------
# Upstash REST API credentials (used by Next.js edge and server routes)
UPSTASH_REDIS_REST_URL=https://<your-instance>.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# Direct Redis connection URL (used by Rust / Axum backend)
REDIS_URL=rediss://default:<your_token>@<your-instance>.upstash.io:6379

# ------------------------------------------------------------------------------
# 5. CLOUDFLARE R2 (ZERO-EGRESS MEDIA OBJECT STORAGE)
# ------------------------------------------------------------------------------
# Never proxy video bytes through application servers. R2 serves streams directly.
R2_ACCOUNT_ID=46f7bef008a04d13a6bd134c3a291006
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=cinephile-staging-media
R2_ENDPOINT=https://46f7bef008a04d13a6bd134c3a291006.r2.cloudflarestorage.com
# Optional: custom domain / Cloudflare CDN public zone for R2 bucket
# R2_PUBLIC_URL=https://media-staging.cinephile.example.com

# ------------------------------------------------------------------------------
# 6. FIREBASE AUTHENTICATION (CLIENT IDENTITY & SERVER-SIDE RS256 VERIFICATION)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=cinefuel-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=cinefuel-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=cinefuel-app.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
FIREBASE_PROJECT_ID=cinefuel-app

# ------------------------------------------------------------------------------
# 7. TMDB & TRAKT METADATA PROVIDERS
# ------------------------------------------------------------------------------
TMDB_API_KEY=your_tmdb_api_key_v3
NEXT_PUBLIC_TMDB_API_KEY=your_tmdb_api_key_v3

# Trakt API Client ID for TV episode titles
TRAKT_CLIENT_ID=your_trakt_client_id_here

# ------------------------------------------------------------------------------
# 8. TELEGRAM BOT API (ADMIN AUTOMATION & NOTIFICATIONS)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_ADMIN_CHAT_ID=930928310
TELEGRAM_WEBHOOK_SECRET=generate_a_random_webhook_secret_string

# ------------------------------------------------------------------------------
# 9. CLOUDFLARE WORKERS (EDGE STAGING RUNTIME)
# ------------------------------------------------------------------------------
# Account & API tokens used by Wrangler / GitHub Actions for edge deployments
CLOUDFLARE_ACCOUNT_ID=46f7bef008a04d13a6bd134c3a291006
# CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
