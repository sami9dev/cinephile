# ==============================================================================
# CiNEPHiLE — Unified Environment Variables Template
#
# Covers Architectural Services:
# 1. Next.js Core
# 2. Supabase (Authoritative PostgreSQL Database)
# 3. Upstash Redis (Cache & Rate Limits)
# 4. Firebase Authentication
# 5. TMDB API (Metadata)
# 6. Telegram Bot API (Admin Automation)
# 7. Cloudflare Workers (Edge Runtime)
#
# DO NOT COMMIT REAL CREDENTIALS. Copy this file to `.env.local` for local
# development or configure variables in your deployment environments.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NEXT.JS FRONTEND & APPLICATION CORE
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PORT=3000
APP_ENV=staging
CINEFUEL_ENV=staging

# ------------------------------------------------------------------------------
# 2. ADMIN AUTHENTICATION
# ------------------------------------------------------------------------------
ADMIN_SECRET_KEY=generate_a_secure_random_hex_key_for_hmac_sessions
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_EMAILS=admin@example.com

# ------------------------------------------------------------------------------
# 3. SUPABASE (AUTHORITATIVE POSTGRESQL DATABASE)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://fnhctuafnvvyeuyrduim.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# ------------------------------------------------------------------------------
# 4. UPSTASH REDIS (CATALOG CACHE & EPHEMERAL RATE LIMITING)
# ------------------------------------------------------------------------------
# Upstash REST API credentials (used by Next.js edge and server routes)
UPSTASH_REDIS_REST_URL=https://<your-instance>.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here
REDIS_URL=rediss://default:<your_token>@<your-instance>.upstash.io:6379

# ------------------------------------------------------------------------------
# 5. FIREBASE AUTHENTICATION (CLIENT IDENTITY & SERVER-SIDE RS256 VERIFICATION)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=cinefuel-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=cinefuel-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=cinefuel-app.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
FIREBASE_PROJECT_ID=cinefuel-app

# ------------------------------------------------------------------------------
# 6. TMDB METADATA PROVIDER
# ------------------------------------------------------------------------------
TMDB_API_KEY=your_tmdb_api_key_v3
NEXT_PUBLIC_TMDB_API_KEY=your_tmdb_api_key_v3
# Optional: TMDB v4 API Read Access Token (Bearer JWT)
# TMDB_READ_ACCESS_TOKEN=your_tmdb_v4_read_access_token_here

# ------------------------------------------------------------------------------
# 7. TELEGRAM BOT API (ADMIN AUTOMATION & NOTIFICATIONS)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_BOT_USERNAME=CineFlue_bot
TELEGRAM_ADMIN_CHAT_ID=930928310
TELEGRAM_WEBHOOK_SECRET=generate_a_random_webhook_secret_string

# ------------------------------------------------------------------------------
# 8. CLOUDFLARE WORKERS & GITHUB ACTIONS DIAGNOSTICS
# ------------------------------------------------------------------------------
# Account & API tokens used by Wrangler / GitHub Actions for edge deployments
CLOUDFLARE_ACCOUNT_ID=46f7bef008a04d13a6bd134c3a291006
# CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
# Optional: GitHub Personal Access Token for 5,000 req/hr GitHub Actions status checks
# GITHUB_TOKEN=your_github_pat_here
